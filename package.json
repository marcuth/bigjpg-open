{
  "name": "bigjpg-open",
  "version": "0.1.0",
  "description": "TypeScript client for the Bigjpg API, to enlarge images with AI",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/*",
    "!/**/__tests__"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx ./src/index.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "bigjpg",
    "image",
    "upscale",
    "enlarge",
    "ai",
    "api",
    "client",
    "marcuth"
  ],
  "author": "Marcuth",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcuth/bigjpg-open.git"
  },
  "homepage": "https://github.com/marcuth/bigjpg-open#readme",
  "bugs": {
    "url": "https://github.com/marcuth/bigjpg-open/issues"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}

